// generated into the build dir by CMakeLists.txt (configure_file), version from project()

#include <winver.h>

// glfw uses an icon called GLFW_ICON for its windows, the tray loads it too. explorer shows it for the exe
GLFW_ICON ICON "@CMAKE_SOURCE_DIR@/assets/clipper.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Kimscode Studio"
            VALUE "FileDescription", "Clipper - clipboard history"
            VALUE "FileVersion", "@PROJECT_VERSION@@CLIPPER_VERSION_SUFFIX@"
            VALUE "InternalName", "Clipper"
            VALUE "LegalCopyright", "Copyright (c) 2026 KimsFerdy, MIT license"
            VALUE "OriginalFilename", "Clipper.exe"
            VALUE "ProductName", "Clipper"
            VALUE "ProductVersion", "@PROJECT_VERSION@@CLIPPER_VERSION_SUFFIX@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
